{
  "name": "continuous",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build && node scripts/pages-fallback.mjs",
    "preview": "vite preview --host",
    "deploy": "bash deploy.sh",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/lib/library.test.ts src/lib/albumSettings.test.ts src/lib/routes.test.ts"
  },
  "dependencies": {
    "emoji-picker-react": "^5.1.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "gh-pages": "^6.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.2"
  }
}
